# Binaries
*.exe
*.exe~
*.dll
*.so
*.dylib

# Test binary, built with `go test -c`
*.test

# Output of the go coverage tool
*.out

# Go workspace file
go.work

# IDE files
.vscode/
.idea/
*.swp
*.swo

# OS files
.DS_Store
Thumbs.db

# Tools directory - exclude large binaries and generated files
bin/
tools/bin/
.gotmp/
.gocache/
tools/results/*.pgn
tools/results/*.log
tools/results/*.jsonl
tools/engines/
tools/cutechess.AppImage
tools/engines.json

# Temporary files
*.tmp
*.log

# Profiling data
profiles/

# Test data - large EPD files
testdata/

# ...except the small, checked-in golden node-count file that gates search
# refactors (internal/search/golden_test.go). Both the directory and the file
# need explicit negation: a trailing-slash ignore of testdata/ excludes the
# directory itself, and git won't recurse into an excluded directory to
# evaluate file-level negations unless the directory is un-ignored too.
!internal/search/testdata/
!internal/search/testdata/search_golden.json

# Claude Code documentation
CLAUDE.md
docs/*

# Configuration files
*.yml
*.yaml
!/.golangci.yml

# Coverage report output
coverage/
